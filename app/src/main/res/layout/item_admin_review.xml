<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminReview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#DCEFE4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgReviewUserAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#E5E7EB"
                android:contentDescription="Reporter avatar"
                android:padding="8dp"
                android:src="@drawable/ic_admin_profile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewerRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reviewer"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReviewUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Sara Ahmed" />

                <TextView
                    android:id="@+id/tvReviewUserContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#596174"
                    android:textSize="10sp"
                    tools:text="sara@email.com  |  01712345678" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:gravity="center"
                    android:minWidth="74dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Pending"
                    android:textColor="#92400E"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_yellow" />

                <TextView
                    android:id="@+id/btnMoreReviewOptions"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="⋮"
                    android:textColor="#6B7280"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvReviewItemTutor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#596174"
            android:textSize="11sp"
            tools:text="Tutor name: Ria" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="REVIEW DESCRIPTION"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReviewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#374151"
            android:textSize="13sp"
            tools:text="The tutor explained the topic clearly and helped me prepare for the exam." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#F1F5F9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewCreatedAt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                tools:text="Oct 24, 10:45 AM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismissReview"
                android:layout_width="86dp"
                android:layout_height="34dp"
                android:text="Dismiss"
                android:textAllCaps="false"
                android:textColor="#17C964"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#17C964"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInvestigateReview"
                android:layout_width="98dp"
                android:layout_height="34dp"
                android:text="Investigate"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#17C964"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>