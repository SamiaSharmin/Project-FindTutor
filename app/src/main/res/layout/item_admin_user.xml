<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminUser"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="108dp"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbSelectUser"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:buttonTint="#9CA3AF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


        <ImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="#E5E7EB"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_admin_profile"
            android:contentDescription="User avatar"
            android:layout_marginTop="26dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/cbSelectUser"
            app:layout_constraintStart_toEndOf="@id/cbSelectUser"
            app:layout_constraintEnd_toStartOf="@id/tvUserStatus"
            tools:text="Sarah Jenkins" />

        <TextView
            android:id="@+id/tvUserStatus"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Active"
            android:textColor="#166534"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#DCFCE7"
            app:layout_constraintTop_toTopOf="@id/tvUserName"
            app:layout_constraintEnd_toStartOf="@id/btnMoreUserOptions" />

        <TextView
            android:id="@+id/btnMoreUserOptions"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#6B7280"
            android:textSize="18sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/tvUserStatus"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvUserRole"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Tutor"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#17C964"
            app:layout_constraintTop_toBottomOf="@id/tvUserName"
            app:layout_constraintStart_toEndOf="@id/cbSelectUser" />

        <TextView
            android:id="@+id/tvUserRating"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="★ 4.9"
            android:textColor="#92400E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#FEF3C7"
            app:layout_constraintTop_toTopOf="@id/tvUserRole"
            app:layout_constraintStart_toEndOf="@id/tvUserRole" />

        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:textColor="#596174"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/tvUserRole"
            app:layout_constraintStart_toEndOf="@id/imgUserAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="sarah@email.com" />

        <TextView
            android:id="@+id/tvUserMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="#596174"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@id/tvUserEmail"
            app:layout_constraintStart_toEndOf="@id/imgUserAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Dhaka, BD     Joined Oct 12, 2023" />
    </androidx.constraintlayout.widget.ConstraintLayout>



</com.google.android.material.card.MaterialCardView>