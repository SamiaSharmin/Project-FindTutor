<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminMeeting"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="142dp"
        android:orientation="vertical"
        android:padding="14dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMeetingStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Student: Sarah Jenkins" />

                <TextView
                    android:id="@+id/tvMeetingTutorName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#596174"
                    android:textSize="12sp"
                    tools:text="Tutor ID: tutor123" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMeetingStatus"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Pending"
                android:textColor="#92400E"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_yellow" />

            <TextView
                android:id="@+id/btnMoreMeetingOptions"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#6B7280"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Job ID"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMeetingJobId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="JOB-102" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Phone"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMeetingStudentPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="01712345678" />

            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMeetingDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="Jan 12, 2024" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMeetingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="6:00 PM" />

            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvMeetingLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#374151"
                android:textSize="12sp"
                tools:text="Uttara, Dhaka" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMeetingReviewInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMeetingReviewSubmitted"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_badge_gray"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="No Review"
                android:textColor="#374151"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMeetingReviewRating"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_yellow"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="0.0"
                android:textColor="#92400E"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>