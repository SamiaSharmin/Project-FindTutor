<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminPost"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="128dp"
        android:orientation="vertical"
        android:padding="14dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Advanced Calculus Tutor Needed" />

                <TextView
                    android:id="@+id/tvPostSubjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#596174"
                    android:textSize="12sp"
                    tools:text="Mathematics, Physics" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPostStatus"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Open"
                android:textColor="#166534"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#DCFCE7" />

            <TextView
                android:id="@+id/btnMorePostOptions"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#6B7280"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salary"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostSalary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="8000 BDT" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="Uttara" />

            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Class"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostStudentClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="Class 10" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schedule"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="3 days, 6 PM" />

            </LinearLayout>

        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student Gender"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostStudentGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="Female" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferred Tutor"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPostPreferredTutorGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    tools:text="Any" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvPostDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#596174"
            android:textSize="12sp"
            tools:text="Need an experienced tutor for weekly home tutoring. Student needs help with basics and exam preparation." />

        <LinearLayout
            android:id="@+id/layoutPostActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClosePost"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="#374151"
                android:textSize="11sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHidePost"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Hide"
                android:textAllCaps="false"
                android:textColor="#92400E"
                android:textSize="11sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#FCD34D"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemovePost"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Remove"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="11sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#F5CCCC"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>